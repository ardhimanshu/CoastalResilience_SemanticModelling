  <rdf:Description rdf:about="https://example.org/coastal-resilience#ResilientShoresResilientCommunities">
    <rdf:type rdf:resource="https://example.org/coastal-resilience#TrainingExchange"/>
    <rdfs:label>Resilient Shores, Resilient Communities</rdfs:label>
    <cr:deliveredBy rdf:resource="https://example.org/coastal-resilience#SPC"/>
    <cr:hasPartner rdf:resource="https://example.org/coastal-resilience#IUCN"/>
    <cr:hasPartner rdf:resource="https://example.org/coastal-resilience#SPREP"/>
    <cr:hasPartner rdf:resource="https://example.org/coastal-resilience#GGGI"/>
    <cr:supportedBy rdf:resource="https://example.org/coastal-resilience#RECCAInitiative"/>
    <cr:durationDays rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cr:durationDays>
    <cr:participantCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</cr:participantCount>
    <cr:femaleParticipantPercentage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">51.0</cr:femaleParticipantPercentage>
    <cr:includedCountry rdf:resource="https://example.org/coastal-resilience#Fiji"/>
    <cr:includedCountry rdf:resource="https://example.org/coastal-resilience#Tonga"/>
    <cr:includedCountry rdf:resource="https://example.org/coastal-resilience#Vanuatu"/>
    <cr:strengthensCapacity rdf:resource="https://example.org/coastal-resilience#TechnicalCapacityForNbS"/>
    <cr:strengthensCapacity rdf:resource="https://example.org/coastal-resilience#ImplementationCapacityForNbS"/>
    <cr:strengthensCapacity rdf:resource="https://example.org/coastal-resilience#MonitoringCapacityForNbS"/>
    <cr:strengthensCapacity rdf:resource="https://example.org/coastal-resilience#CommunityEngagementCapacityForNbS"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#MangroveSpeciesSelection"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#SiteSuitabilityAssessment"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#TidalFlow"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#SedimentDynamics"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#EcosystemInteractions"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#LandUseAssessment"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#EcosystemMonitoringMethods"/>
    <cr:coveredTopic rdf:resource="https://example.org/coastal-resilience#CommunityEngagement"/>
    <cr:producesOutput rdf:resource="https://example.org/coastal-resilience#SiteSpecificActionPlans"/>
  </rdf:Description>
